{
  "name": "chatze-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3001",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "setup": "node scripts/auto-setup.mjs",
    "setup:sharded": "node scripts/auto-setup.mjs --sharded",
    "deploy": "node scripts/auto-setup.mjs --deploy",
    "deploy:quick": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/kv-asset-handler": "^0.5.0",
    "hono": "^4.13.12",
    "lucide-react": "^1.16.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "vite": "^8.3.1",
    "wrangler": "^4.143.1"
  }
}
