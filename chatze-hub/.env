# Chatze Hub Environment Configuration

# 1. Google OAuth 2.0 Web Client ID
# Obtain from https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# 2. Cloudflare API Token (Optional: Use this if `wrangler login` fails on Windows)
# Create at https://dash.cloudflare.com/profile/api-tokens with "Edit Cloudflare Workers" template
CLOUDFLARE_API_TOKEN=

# 3. Security & Branding
VITE_HUB_NAME="Chatze Hub Gateway (Nepal)"
JWT_SECRET=chatze-hub-default-jwt-secret-replace-in-production
